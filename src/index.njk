---
layout: layouts/base.njk
permalink: /
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="kicker">{{ site.tagline }}</p>
    <h1 id="hero-title">{{ site.headline }}</h1>
    <div class="who">{% renderFile "./src/fragments/home-intro.md" %}</div>
    <p class="cta">
      <a class="btn" href="/writing/">Read the writing</a>
      <a href="{{ site.linkedin }}">Connect on LinkedIn ↗</a>
    </p>
  </div>
</section>

<section class="home-block" aria-labelledby="latest">
  <div class="wrap">
    <h2 class="section-title" id="latest">Latest notes</h2>
    <ul class="post-list">
{%- for n in collections.notes | limit(4) %}
      <li>
        <p class="meta"><time datetime="{{ n.date | isoDate }}">{{ n.date | readableDate }}</time> · {{ (n.data.tags | reject("equalto","notes") | first) | tagLabel }} · {{ n.data.readingMinutes }} min read</p>
        <h3><a href="{{ n.url }}">{{ n.data.home_title or n.data.title }}</a></h3>
        <p>{{ n.data.summary }}</p>
      </li>
{%- endfor %}
    </ul>
    <a class="more" href="/writing/">All writing →</a>
  </div>
</section>

<section class="lab-band" aria-labelledby="lab">
  <div class="wrap">
    <h2 class="section-title" id="lab">From the lab</h2>
    <ul class="lab-list">
      <li>
        <strong><a href="/lab/">Meshtastic in Basel</a></strong>
        <p>An off-grid backup radio for my family that turned into helping grow the Swiss LoRa mesh.</p>
      </li>
      <li>
        <strong><a href="{{ site.reddit }}">r/risorseumane</a></strong>
        <p>An Italian-language community for questions about HR, careers and working life.</p>
      </li>
      <li>
        <strong><a href="/lab/#lists">Three X lists</a></strong>
        <p>Who’s worth reading on work and organizations, on AI, and on Basel.</p>
      </li>
    </ul>
  </div>
</section>
{# Old single-page URLs (#notes/<id>, #projects, #about) keep working. #}
<script>
(function () {
  var h = location.hash.replace(/^#\/?/, "");
  if (!h) return;
  var base = "{{ '/' | htmlBaseUrl }}"; // "/" or a path prefix such as "/preview/"
  var notes = {{ collections.legacyRedirects | json | safe }};
  var pages = { home: null, notes: "/writing/", projects: "/lab/", about: "/about/" };
  var m = h.match(/^notes\/([a-z0-9-]+)/);
  var to = m ? (notes[m[1]] || "/writing/") : pages[h];
  if (to) location.replace(base + to.replace(/^\//, ""));
})();
</script>
