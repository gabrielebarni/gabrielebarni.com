---
layout: layouts/base.njk
permalink: /
---
<div class="wrap">
<section class="hero" aria-labelledby="h">
<p class="kicker">{{ site.tagline }}</p>
<h1 id="h">{{ site.headline }}</h1>
<div class="who">{% renderFile "./src/fragments/home-intro.md" %}</div>
<div class="cta"><a class="btn" href="/writing/">Read the writing</a><a href="{{ site.linkedin }}">Connect on LinkedIn ↗</a></div>
</section>
<div class="cols">
<section aria-labelledby="latest"><h2 class="section-title" id="latest">Latest notes</h2>
<ul class="post-list">
{%- for n in collections.notes | limit(4) %}
<li><p class="meta"><time datetime="{{ n.date | isoDate }}">{{ n.date | readableDate }}</time> · {{ (n.data.tags | reject("equalto","notes") | first) | tagLabel }} · {{ n.data.readingMinutes }} min read</p>
<h3><a href="{{ n.url }}">{{ n.data.home_title or n.data.title }}</a></h3><p>{{ n.data.summary }}</p></li>
{%- endfor %}
</ul>
<a class="more" href="/writing/">All writing →</a></section>
<section aria-labelledby="lab"><h2 class="section-title" id="lab">From the lab</h2>
<ul class="lab-list">
<li><strong><a href="/lab/">Meshtastic in Basel</a></strong><p>An off-grid backup radio for my family that turned into helping grow the Swiss LoRa mesh.</p></li>
<li><strong><a href="{{ site.reddit }}">r/risorseumane</a></strong><p>An Italian-language community for questions about HR, careers and working life.</p></li>
<li><strong><a href="/lab/#lists">Three X lists</a></strong><p>Who’s worth reading on work and organizations, on AI, and on Basel.</p></li>
</ul></section>
</div>
</div>
{# Old single-page URLs (#notes/<id>, #projects, #about) keep working. #}
<script>
(function () {
  var h = location.hash.replace(/^#\/?/, "");
  if (!h) return;
  var notes = {{ collections.legacyRedirects | json | safe }};
  var pages = { home: null, notes: "/writing/", projects: "/lab/", about: "/about/" };
  var m = h.match(/^notes\/([a-z0-9-]+)/);
  var to = m ? (notes[m[1]] || "/writing/") : pages[h];
  if (to) location.replace(to);
})();
</script>
