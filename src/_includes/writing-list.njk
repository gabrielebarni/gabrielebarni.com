{%- set essays = [] -%}{%- set shorts = [] -%}
{%- for n in collections.notes -%}
{%- if n.data.featured -%}{%- set essays = (essays.push(n), essays) -%}{%- else -%}{%- set shorts = (shorts.push(n), shorts) -%}{%- endif -%}
{%- endfor -%}
<div class="wrap"><div class="read" style="padding-top:3.5rem">
<h1>{{ tagTitle or "Writing" }}</h1>
<p class="lede">{{ tagLede or "Notes on people, work and AI. Short, with a point of view and sources included." }}</p>
<ul class="filters" aria-label="Topics">
<li><a href="/writing/"{% if not tag %} aria-current="page"{% endif %}>All</a></li>
{%- for t in collections.noteTags %}
<li><a href="/writing/tags/{{ t }}/"{% if tag == t %} aria-current="page"{% endif %}>{{ t | tagLabel }}</a></li>
{%- endfor %}
</ul>
{%- if not tag %}
<div id="search" hidden>
<form class="search" role="search" action="" method="get">
<label for="q">Search notes and pages. Runs in your browser; nothing is sent anywhere.</label>
<input id="q" name="q" type="search" placeholder="e.g. onboarding, agents, Meshtastic" autocomplete="off" spellcheck="false" enterkeyhint="search">
</form>
<p id="search-status" class="search-hint" role="status" aria-live="polite"></p>
<div id="search-results"></div>
</div>
</div>
{%- endif %}
<div id="listing">
{%- macro row(n) %}
<div class="row"><time datetime="{{ n.date | isoDate }}">{{ n.date | readableDate }}</time><div><h3><a href="{{ n.url }}">{{ n.data.title }}</a></h3><p>{{ n.data.summary }}</p><p class="meta">{{ (n.data.tags | reject("equalto","notes") | first) | tagLabel }} · {{ n.data.readingMinutes }} min read</p></div></div>
{%- endmacro %}
{%- if not tag %}
<h2 class="year">Essays</h2>
{%- for n in essays %}{{ row(n) }}{% endfor %}
<h2 class="year">Short notes</h2>
{%- for n in shorts %}{{ row(n) }}{% endfor %}
{%- else %}
<h2 class="year">{{ tag | tagLabel }}</h2>
{%- for n in collections.notes %}{% if tag in n.data.tags %}{{ row(n) }}{% endif %}{% endfor %}
{%- endif %}
</div>
</div></div>
{%- if not tag %}
<script type="module">
// Progressive enhancement: without JS (or if the index fails to load) the full list stays.
// The Pagefind bundle path goes through htmlBaseUrl, so it works at / and under a path prefix
// (e.g. /preview/); Pagefind then derives result URLs from the bundle's location.
const BUNDLE = "{{ '/pagefind/pagefind.js' | htmlBaseUrl }}";
const $ = (id) => document.getElementById(id);
const box = $("search"), form = box.querySelector("form"), q = $("q"), out = $("search-results"), status = $("search-status"), listing = $("listing");
const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
let pf, seq = 0, timer;
// Pagefind falls back to very short prefixes for unknown words (a typo like "onbording" matches
// every "on"), which floods the list with noise. Keep a result only if, for every query word,
// the page has a word sharing a long enough prefix with it (stemming-friendly, no typos).
const norm = (s) => String(s || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
const words = (s) => norm(s).split(/[^\p{L}\p{N}]+/u).filter(Boolean);
const shared = (a, b) => { let i = 0; while (i < a.length && i < b.length && a[i] === b[i]) i++; return i; };
const relevant = (terms, d) => {
  const vocab = new Set(words(d.meta?.title + " " + d.content));
  return terms.every((t) => {
    const need = t.length <= 5 ? t.length : Math.max(5, t.length - 3);
    for (const w of vocab) if (shared(t, w) >= need) return true;
    return false;
  });
};
const load = () => (pf ??= import(BUNDLE).then(async (m) => { await m.options({ excerptLength: 24 }); m.init(); return m; }));

function show(term) {
  const url = new URL(location.href);
  term ? url.searchParams.set("q", term) : url.searchParams.delete("q");
  history.replaceState(null, "", url);
}
async function run() {
  const term = q.value.trim(), mine = ++seq;
  show(term);
  if (!term) { out.innerHTML = ""; status.textContent = ""; listing.hidden = false; return; }
  let res, data;
  try {
    const m = await load();
    res = await m.search(term);
    if (mine !== seq || !res) return; // a newer query is already running
    data = await Promise.all(res.results.map((r) => r.data()));
    const terms = words(term);
    data = data.filter((d) => relevant(terms, d));
  } catch (e) {
    if (mine !== seq) return;
    pf = undefined; // allow a retry
    listing.hidden = false; out.innerHTML = "";
    status.textContent = "Search couldn’t load. All notes are listed below.";
    return;
  }
  if (mine !== seq) return;
  listing.hidden = true;
  const n = data.length;
  status.textContent = n ? `${n} result${n === 1 ? "" : "s"} for “${term}”` : `Nothing matches “${term}”. Try a shorter or broader word, or clear the search to see all notes.`;
  out.innerHTML = (n ? '<h2 class="year">Search results</h2>' : "") + data.map((d) => `<div class="row"><span class="kind">${esc(d.filters?.topic?.[0] || d.meta?.kind || "Note")}</span><div><h3><a href="${esc(d.url)}">${esc(d.meta?.title)}</a></h3><p>${d.excerpt}</p></div></div>`).join("");
}
q.addEventListener("input", () => { clearTimeout(timer); timer = setTimeout(run, 180); });
q.addEventListener("focus", load, { once: true });
q.addEventListener("keydown", (e) => { if (e.key === "Escape" && q.value) { q.value = ""; run(); } });
form.addEventListener("submit", (e) => { e.preventDefault(); clearTimeout(timer); run(); q.blur(); });
box.hidden = false;
const initial = new URLSearchParams(location.search).get("q");
if (initial) { q.value = initial; run(); }
</script>
{%- endif %}
