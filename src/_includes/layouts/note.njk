---
layout: layouts/base.njk
---
{%- set noteTags = tags | reject("equalto", "notes") -%}
<article class="wrap" data-pagefind-body>
  <div class="read article">
    <header>
      <p class="meta" data-pagefind-ignore><a href="/writing/">Writing</a>{% if noteNumber %} · #{{ noteNumber }}{% endif %}{% for t in noteTags %} · <span data-pagefind-filter="topic">{{ t | tagLabel }}</span>{% endfor %}</p>
      <h1 data-pagefind-meta="title">{{ title }}</h1>
{%- if summary %}
      <p class="lede">{{ summary }}</p>
{%- endif %}
      <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time> · {{ readingMinutes }} min read</p>
    </header>
    <div class="prose">
      {{ content | safe }}
    </div>
{%- if noteTags.length %}
    <nav aria-label="Topics" data-pagefind-ignore>
    <ul class="tags">
{%- for t in noteTags %}
      <li><a href="/writing/tags/{{ t }}/">{{ t | tagLabel }}</a></li>
{%- endfor %}
    </ul>
    </nav>
{%- endif %}
{%- set seeAlso = [] -%}
{%- for id in see_also or [] -%}
  {%- set r = collections.notes | findByLegacyId(id) -%}
  {%- if r and r.url != page.url -%}{%- set seeAlso = (seeAlso.push(r), seeAlso) -%}{%- endif -%}
{%- endfor %}
{%- set relatedNotes = [] -%}
{%- for id in related or [] -%}
  {%- set r = collections.notes | findByLegacyId(id) -%}
  {%- if r and r.url != page.url and (relatedNotes | length) < 4 and not (r in relatedNotes) and not (r in seeAlso) -%}{%- set relatedNotes = (relatedNotes.push(r), relatedNotes) -%}{%- endif -%}
{%- endfor %}
{%- set incoming = collections.notes | backlinks(page.url) -%}
{%- if relatedNotes.length %}
    <section class="note-links" data-pagefind-ignore>
    <h2 class="link-heading">Links to</h2>
    <nav class="next" aria-label="Links to">
{%- for r in relatedNotes %}
      <a href="{{ r.url }}"><span class="meta">{% if r.data.noteNumber %}#{{ r.data.noteNumber }} · {% endif %}{{ (r.data.tags | reject("equalto","notes") | first) | tagLabel }}</span><span>{{ r.data.title }}</span></a>
{%- endfor %}
    </nav>
    </section>
{%- endif %}
{%- if incoming.length %}
    <section class="note-links" data-pagefind-ignore>
    <h2 class="link-heading">Linked from</h2>
    <ul class="backlink-list">
{%- for b in incoming %}
      <li>{% if b.data.noteNumber %}<span class="meta">#{{ b.data.noteNumber }}</span> {% endif %}<a href="{{ b.url }}">{{ b.data.title }}</a></li>
{%- endfor %}
    </ul>
    </section>
{%- endif %}
{%- if seeAlso.length %}
    <p class="meta see-also" data-pagefind-ignore>Related: {% for r in seeAlso %}{% if not loop.first %} · {% endif %}<a href="{{ r.url }}">{{ r.data.title }}</a>{% endfor %}</p>
{%- endif %}
    <p class="meta" data-pagefind-ignore><a href="/writing/" data-random-note>A random note</a></p>
    <p class="muted" data-pagefind-ignore>Disagree? Tell me on <a href="{{ site.linkedin }}">LinkedIn</a>. That’s where the discussion happens.</p>
  </div>
</article>
