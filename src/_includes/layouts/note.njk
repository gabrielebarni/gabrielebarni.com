---
layout: layouts/base.njk
---
{%- set noteTags = tags | reject("equalto", "notes") -%}
<article class="wrap" data-pagefind-body><div class="read article">
<header>
<p class="meta"><a href="/writing/" data-pagefind-ignore>Writing</a>{% for t in noteTags %} · <span data-pagefind-filter="topic">{{ t | tagLabel }}</span>{% endfor %}</p>
<h1 data-pagefind-meta="title">{{ title }}</h1>
{%- if summary %}<p class="lede">{{ summary }}</p>{% endif %}
<p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time> · {{ readingMinutes }} min read</p>
</header>
<div class="prose">
{{ content | safe }}
</div>
{%- if noteTags.length %}
<ul class="tags" aria-label="Topics" data-pagefind-ignore>{% for t in noteTags %}<li><a href="/writing/tags/{{ t }}/">{{ t | tagLabel }}</a></li>{% endfor %}</ul>
{%- endif %}
{%- set relatedNotes = [] -%}
{%- for id in related or [] -%}
  {%- set r = collections.notes | findByLegacyId(id) -%}
  {%- if r and r.url != page.url and (relatedNotes | length) < 4 and not (r in relatedNotes) -%}{%- set relatedNotes = (relatedNotes.push(r), relatedNotes) -%}{%- endif -%}
{%- endfor %}
{%- if relatedNotes.length %}
<nav class="next" aria-label="Related notes" data-pagefind-ignore>
{%- for r in relatedNotes %}
<a href="{{ r.url }}"><span class="meta">{{ (r.data.tags | reject("equalto","notes") | first) | tagLabel }}</span><span>{{ r.data.title }}</span></a>
{%- endfor %}
</nav>
{%- endif %}
<p class="muted" data-pagefind-ignore>Disagree? Tell me on <a href="{{ site.linkedin }}">LinkedIn</a>. That’s where the discussion happens.</p>
<p class="disclaimer" data-pagefind-ignore>Personal views, not legal advice. Views are my own.</p>
</div></article>
