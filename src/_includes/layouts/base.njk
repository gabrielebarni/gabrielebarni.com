{%- set pageTitle = (title + " — " + site.title) if title and page.url != "/" else (site.title + " — " + site.tagline) -%}
{%- set pageDesc = summary or description or site.description -%}
{%- set canonical = page.url | fullUrl -%}
<!doctype html>
<html lang="{{ site.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta name="author" content="{{ site.author }}">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#151412" media="(prefers-color-scheme: dark)">
<link rel="canonical" href="{{ canonical }}">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/atom+xml" title="{{ site.title }} — Writing" href="/feed.xml">
<link rel="preload" href="/assets/fonts/IBMPlexSerif-SemiBold-Latin1.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/style.css">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:type" content="{{ 'article' if layout == 'layouts/note.njk' else 'website' }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:image" content="{{ '/assets/img/og-default.png' | fullUrl }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_US">
{%- if layout == 'layouts/note.njk' %}
<meta property="article:published_time" content="{{ page.date | isoDate }}">
<meta property="article:author" content="{{ site.author }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ site.xHandle }}">
{% block head %}{% endblock %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head"><div class="wrap">
<a class="brand" href="/"><img class="tile" src="/assets/img/favicon.svg" width="28" height="28" alt="">{{ site.title }}<span aria-hidden="true">.</span></a>
<nav aria-label="Main"><ul>
{%- for item in [["Writing","/writing/"],["Lab","/lab/"],["About","/about/"]] %}
<li><a href="{{ item[1] }}"{% if page.url.startsWith(item[1]) %} aria-current="page"{% endif %}>{{ item[0] }}</a></li>
{%- endfor %}
</ul></nav>
</div></header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-foot"><div class="wrap">
<div><p>{{ site.tagline }}</p><p>Views are my own. No cookies, no trackers.</p><p>Writing licensed <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>.</p><p class="motto" lang="la">Audentes Fortuna iuvat.</p></div>
<ul>
<li><a href="{{ site.linkedin }}">LinkedIn</a></li>
<li><a href="{{ site.x }}">X</a></li>
<li><a href="{{ site.reddit }}">r/risorseumane</a></li>
<li><a href="/feed.xml">RSS</a></li>
<li><a href="{{ site.source }}">Source</a></li>
</ul>
</div></footer>
{% block scripts %}{% endblock %}
</body>
</html>
